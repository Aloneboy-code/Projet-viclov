{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./source/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["source/components/**/*.js", "source/pages/**/*.jsx", "source/Layout.jsx"],
  "exclude": ["node_modules", "dist", "source/vite-plugins", "source/components/ui", "source/api", "source/lib"]
}